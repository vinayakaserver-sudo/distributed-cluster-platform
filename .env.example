# ClusterControl - Root .env template
# Copy this to .env and fill in your values
# This file is used by docker-compose.yml

# Admin credentials for the dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT signing secret - CHANGE THIS in production!
JWT_SECRET=super-secret-jwt-key-change-this-before-deploying

# PostgreSQL URLs for Node 1 (primary) and Node 2 (replica)
# Free options:
#   - Neon: https://neon.tech (free tier: 0.5 GB)
#   - Supabase: https://supabase.com (free tier: 500 MB)
NODE1_DATABASE_URL=postgresql://user:password@host/dbname
NODE2_DATABASE_URL=postgresql://user:password@host/dbname_replica
